APP_NAME=send-flow-backend
APP_ENV=local
LOG_LEVEL=info
HTTP_ADDR=:8081
SHUTDOWN_TIMEOUT=10s
AUTO_MIGRATE=true

FRONTEND_BASE_URL=http://localhost:3000

WORKER_HTTP_ADDR=:8082
WORKER_ENABLED_CONSUMERS=
WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_TIMEOUT=10s
WORKER_CONSUMER_GROUP_PREFIX=send-flow

DATABASE_URL=postgres://sendflow:sendflow@localhost:5432/sendflow?sslmode=disable
DATABASE_READ_URL=postgres://sendflow:sendflow@localhost:5433/sendflow?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

KAFKA_BROKERS=localhost:9092
CLICKHOUSE_DSN=clickhouse://sendflow:sendflow@localhost:9000/sendflow

EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sendflow.local

SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
SES_ENDPOINT=
SES_FROM=
SES_CONFIGURATION_SET=

AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h
AUTH_MFA_CHALLENGE_TTL=10m

OBJECT_STORAGE_ENDPOINT=localhost:9001
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=minio-secret
OBJECT_STORAGE_BUCKET=sendflow-local
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_USE_SSL=false

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_STATE_TTL=10m

JWT_ISSUER=send-flow
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

UNSUBSCRIBE_TOKEN_SECRET=dev-unsubscribe-secret-change-me
