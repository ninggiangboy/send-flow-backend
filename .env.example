APP_NAME=send-flow-backend
APP_ENV=local
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
AUTO_MIGRATE=false

# Runtime identity. The Makefile sets these automatically for local api/worker targets.
SERVICE_NAME=
INSTANCE_ID=
INSTANCE_ADDR=
POD_NAME=
POD_NAMESPACE=
NODE_NAME=

FRONTEND_BASE_URL=http://localhost:5173
# Comma-separated list of CORS allowed origins. Defaults to FRONTEND_BASE_URL if empty.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://app.sendflow.com

SERVICE_DISCOVERY_PROVIDER=consul
CONSUL_HTTP_ADDR=http://localhost:8500
CONSUL_SERVICE_NAME=sendflow-api
CONSUL_SERVICE_ID=sendflow-api-local
CONSUL_SERVICE_ADDRESS=host.docker.internal
CONSUL_HEALTH_CHECK_PATH=/api/readyz
CONSUL_WORKER_SERVICE_NAME=sendflow-worker
CONSUL_WORKER_SERVICE_ID=sendflow-worker-local
CONSUL_WORKER_SERVICE_ADDRESS=host.docker.internal
CONSUL_WORKER_HEALTH_CHECK_PATH=/api/readyz

WORKER_ENABLED_CONSUMERS=delivery.queue_campaign_messages,delivery_provider_events,tracking_provider_events,delivery.due_message_scheduler,delivery.due_message_consumer,analytics_events,analytics.clickhouse_sync,analytics.detect_anomalies,analytics.outbox_lag_sampler,notification.identity_events,notification.due_notification_scheduler,notification.due_notification_consumer,webhooks.deliver_events,webhooks.due_webhook_scheduler,webhooks.due_webhook_consumer,audience.import_processor,audience.export_processor
WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_TIMEOUT=10s
WORKER_CONSUMER_GROUP_PREFIX=send-flow

DATABASE_URL=postgres://sendflow:sendflow@localhost:5432/sendflow?sslmode=disable
DATABASE_READ_URL=postgres://sendflow:sendflow@localhost:5433/sendflow?sslmode=disable
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis cache feature toggles and TTLs.
# All features are disabled by default; enable them incrementally per module.
# REDIS_CACHE_IDENTITY_ACCESS_ENABLED=false
# REDIS_CACHE_IDENTITY_ACCESS_TTL=5m
# REDIS_CACHE_IDENTITY_SETTINGS_ENABLED=false
# REDIS_CACHE_IDENTITY_SETTINGS_TTL=5m
# REDIS_CACHE_CONTENT_PREVIEW_ENABLED=false
# REDIS_CACHE_CONTENT_PREVIEW_TTL=10m
# REDIS_CACHE_SENDER_READINESS_ENABLED=false
# REDIS_CACHE_SENDER_READINESS_TTL=5m
# REDIS_CACHE_AUDIENCE_RESOLUTION_ENABLED=false
# REDIS_CACHE_AUDIENCE_RESOLUTION_TTL=2m
# REDIS_CACHE_DELIVERY_IDEMPOTENCY_ENABLED=false
# REDIS_CACHE_DELIVERY_IDEMPOTENCY_TTL=24h
# REDIS_CACHE_DELIVERY_QUOTA_ENABLED=false
# REDIS_CACHE_DELIVERY_QUOTA_TTL=1m
# REDIS_CACHE_ANALYTICS_QUERY_ENABLED=false
# REDIS_CACHE_ANALYTICS_QUERY_TTL=1m


CLICKHOUSE_DSN=clickhouse://sendflow:sendflow@localhost:9000/sendflow

KAFKA_BROKERS=localhost:19092

# EMAIL_PROVIDER must be "smtp", "ses", or "fake". "fake" is only allowed in APP_ENV=local or APP_ENV=test.
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@sendflow.local

SES_REGION=us-east-1
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_SESSION_TOKEN=
SES_ENDPOINT=
SES_FROM=
SES_CONFIGURATION_SET=

AUTH_EMAIL_VERIFICATION_TTL=24h
AUTH_PASSWORD_RESET_TTL=1h
AUTH_MFA_CHALLENGE_TTL=10m

OBJECT_STORAGE_ENDPOINT=localhost:9001
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY_ID=minio
OBJECT_STORAGE_SECRET_ACCESS_KEY=minio-secret
OBJECT_STORAGE_BUCKET=sendflow-local
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_USE_SSL=false

OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_STATE_TTL=10m

JWT_ISSUER=send-flow
# IMPORTANT: In production/staging, set these to real, random secrets (e.g. openssl rand -hex 64).
# Using the defaults below in non-local environments will cause the application to reject them.
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# Set a real secret in production (change from the dev default).
UNSUBSCRIBE_TOKEN_SECRET=dev-unsubscribe-secret-change-me
