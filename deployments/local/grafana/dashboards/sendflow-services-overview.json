    {
      "id": 25,
      "type": "table",
      "title": "Per-instance Health And Runtime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"sendflow-.*\", service_id=~\"$instance_id\"}",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (job, service_id) (rate(sendflow_http_requests_total{job=~\"$job\", service_id=~\"$instance_id\", method=~\"$method\", route=~\"$route\", status=~\"$status\"}[5m]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.95, sum by (job, service_id, le) (rate(sendflow_http_request_duration_seconds_bucket{job=~\"$job\", service_id=~\"$instance_id\", method=~\"$method\", route=~\"$route\", status=~\"$status\"}[5m])))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum by (job, service_id) (rate(sendflow_http_requests_total{job=~\"$job\", service_id=~\"$instance_id\", status=~\"5..\"}[5m])) / clamp_min(sum by (job, service_id) (rate(sendflow_http_requests_total{job=~\"$job\", service_id=~\"$instance_id\"}[5m])), 0.001)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "sum by (job, service_id) (rate(process_cpu_seconds_total{job=~\"$job\", service_id=~\"$instance_id\"}[5m]) or rate(sendflow_process_cpu_seconds_total{job=~\"$job\", service_id=~\"$instance_id\"}[5m]))",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "sum by (job, service_id) (process_resident_memory_bytes{job=~\"$job\", service_id=~\"$instance_id\"} or sendflow_process_resident_memory_bytes{job=~\"$job\", service_id=~\"$instance_id\"})",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "sum by (job, service_id) (go_goroutines{job=~\"$job\", service_id=~\"$instance_id\"})",
          "format": "table",
          "instant": true
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
