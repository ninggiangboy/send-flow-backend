          "refId": "A",
          "expr": "{job=\"sendflow-files\", service=~\"$app_service\"} |~ \"(?i)error|panic|fatal|exception\" | json | route!=\"/api/metrics\" | route!=\"/api/healthz\" | route!=\"/api/readyz\" | line_format `{{.level}} [{{.app}}/{{.env}}] {{.msg}}{{with .usecase}} usecase={{.}}{{end}}{{with .user_id}} user={{.}}{{end}}{{with .workspace_id}} workspace={{.}}{{end}}{{with .request_id}} request={{.}}{{end}}{{with .trace_id}} trace={{.}}{{end}}{{with .route}} route={{.}}{{end}}{{with .status}} status={{.}}{{end}}{{with .duration_ms}} duration_ms={{.}}{{end}}{{with .error}} error={{.}}{{end}}`"
        },
