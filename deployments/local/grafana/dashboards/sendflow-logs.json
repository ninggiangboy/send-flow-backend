      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({job=\"sendflow-files\", service=~\"$app_service\"} |~ \"(?i)warn|warning\"[5m])) * 60"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
