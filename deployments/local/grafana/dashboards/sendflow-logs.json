    {
      "id": 9,
      "type": "logs",
      "title": "API / Worker Logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 14,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"sendflow-files\", service=~\"$app_service\", level=~\"$level\"} | json | route!=\"/api/metrics\" | route!=\"/api/healthz\" | route!=\"/api/readyz\" | line_format `{{.level}} [{{.app}}/{{.env}}] {{.msg}}{{with .usecase}} usecase={{.}}{{end}}{{with .user_id}} user={{.}}{{end}}{{with .workspace_id}} workspace={{.}}{{end}}{{with .request_id}} request={{.}}{{end}}{{with .trace_id}} trace={{.}}{{end}}{{with .route}} route={{.}}{{end}}{{with .status}} status={{.}}{{end}}{{with .duration_ms}} duration_ms={{.}}{{end}}{{with .error}} error={{.}}{{end}}`"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Local Infra Logs",
      "datasource": {
