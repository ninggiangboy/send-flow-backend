{{define "password_reset_htmlBody"}}<!DOCTYPE html>
<html>
<body style="font-family: Arial, sans-serif; padding: 20px;">
<h2>Reset your password</h2>
<p>We received a request to reset your password. Click the button below to set a new password:</p>
<p><a href="{{.Link}}" style="display: inline-block; padding: 12px 24px; background-color: #4f46e5; color: #ffffff; text-decoration: none; border-radius: 6px;">Reset Password</a></p>
<p>Or copy and paste this link in your browser:</p>
<p><a href="{{.Link}}">{{.Link}}</a></p>
<p>If you did not request a password reset, you can ignore this email.</p>
<p>Best,<br>The SendFlow Team</p>
</body>
</html>{{end}}
